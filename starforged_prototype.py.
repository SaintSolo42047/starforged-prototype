import pygame
import random
import sys

pygame.init()
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Starforged - Character Creation & Prototype")
clock = pygame.time.Clock()
font = pygame.font.SysFont("arial", 28)
small_font = pygame.font.SysFont("arial", 20)

class Character:
    def __init__(self):
        self.stats = {"Edge": 2, "Heart": 2, "Iron": 2, "Shadow": 2, "Wits": 2}
        self.meters = {"Health": 5, "Spirit": 5, "Supply": 5, "Momentum": 2}
        self.progress = 0
        self.selected_stat = 0  # index for creation

    def get_stat_list(self):
        return list(self.stats.keys())

    def draw_stats(self, surface, creation_mode=False):
        y = 120
        stat_names = self.get_stat_list()
        for i, name in enumerate(stat_names):
            color = (255, 255, 100) if i == self.selected_stat and creation_mode else (255, 255, 255)
            text = font.render(f"{name}: {self.stats[name]}", True, color)
            surface.blit(text, (100, y))
            y += 50

class Oracle:
    def __init__(self):
        self.tables = {
            "travel": ["Smooth hyperspace jump", "Pirate intercept", "Derelict signal", "Nebula interference"],
            "combat": ["Enemy fighter engages", "Shield overload", "You gain targeting lock", "Hull breach sustained"],
            "conversation": ["Station hails peacefully", "Captain demands tribute", "AI reveals coordinates", "Faction turns hostile"],
            "obstacle": ["Asteroid field clears", "System glitch arises", "Partial scan success", "Full system failure with cost"]
        }

    def get_reaction(self, context):
        return random.choice(self.tables.get(context, ["Generic space event"]))

def ironsworn_roll(stat_value, bonus=0):
    action_die = random.randint(1, 6)
    challenge1 = random.randint(1, 10)
    challenge2 = random.randint(1, 10)
    total = action_die + stat_value + bonus
    if total > max(challenge1, challenge2):
        return "Strong Hit", total, challenge1, challenge2
    elif total > min(challenge1, challenge2):
        return "Weak Hit", total, challenge1, challenge2
    else:
        return "Miss", total, challenge1, challenge2

def draw_dice(surface, rolling=False, result=None):
    color = (200, 200, 200)
    pygame.draw.rect(surface, color, (300, 300, 60, 60))
    pygame.draw.rect(surface, color, (380, 300, 60, 60))
    pygame.draw.rect(surface, color, (460, 300, 60, 60))
    if rolling:
        text = small_font.render("ROLLING...", True, (255, 255, 0))
        surface.blit(text, (300, 320))
    elif result:
        action_text = small_font.render(str(result[1]), True, (0, 0, 0))
        c1_text = small_font.render(str(result[2]), True, (0, 0, 0))
        c2_text = small_font.render(str(result[3]), True, (0, 0, 0))
        surface.blit(action_text, (320, 320))
        surface.blit(c1_text, (400, 320))
        surface.blit(c2_text, (480, 320))
        outcome_text = font.render(result[0], True, (0, 255, 0) if result[0] == "Strong Hit" else (255, 255, 0) if result[0] == "Weak Hit" else (255, 0, 0))
        surface.blit(outcome_text, (300, 380))
    else:
        text = small_font.render("Press R to roll", True, (200, 200, 200))
        surface.blit(text, (300, 320))

game_state = "creation"
char = Character()
oracle = Oracle()
current_state = "travel"
roll_result = None
rolling = False
frame = 0
ship_x = 650
ship_y = 500

running = True
while running:
    screen.fill((10, 10, 30))
    for _ in range(50):
        pygame.draw.circle(screen, (200, 200, 255), (random.randint(0, SCREEN_WIDTH), random.randint(0, SCREEN_HEIGHT)), 1)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    keys = pygame.key.get_pressed()

    if game_state == "creation":
        title = font.render("CHARACTER CREATION - Starforged", True, (255, 255, 100))
        screen.blit(title, (80, 30))
        total = sum(char.stats.values())
        total_color = (0, 255, 0) if total == 10 else (255, 100, 100)
        total_text = small_font.render(f"Total points: {total} / 10", True, total_color)
        screen.blit(total_text, (80, 80))
        instr = small_font.render("← → = select stat   ↑ ↓ = change value   ENTER = Start Game (total must be 10)", True, (200, 200, 200))
        screen.blit(instr, (50, 520))

        char.draw_stats(screen, creation_mode=True)

        # Stat selection and adjustment
        if keys[pygame.K_LEFT]:
            char.selected_stat = (char.selected_stat - 1) % 5
        if keys[pygame.K_RIGHT]:
            char.selected_stat = (char.selected_stat + 1) % 5
        stat_name = list(char.stats.keys())[char.selected_stat]
        if keys[pygame.K_UP]:
            char.stats[stat_name] = min(4, char.stats[stat_name] + 1)
        if keys[pygame.K_DOWN]:
            char.stats[stat_name] = max(1, char.stats[stat_name] - 1)

        if keys[pygame.K_RETURN] and total == 10:
            game_state = "playing"

    else:  # playing state
        # (the rest of the game loop from the previous version - movement, rolling, etc.)
        # ... [same as last version] ...
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_r:
                rolling = True
                frame = 0
            if event.key == pygame.K_t:
                current_state = "travel"
            if event.key == pygame.K_c:
                current_state = "combat"
            if event.key == pygame.K_v:
                current_state = "conversation"
            if event.key == pygame.K_o:
                current_state = "obstacle"

        move_speed = 5
        if keys[pygame.K_LEFT]:
            ship_x -= move_speed
        if keys[pygame.K_RIGHT]:
            ship_x += move_speed
        if keys[pygame.K_UP]:
            ship_y -= move_speed
        if keys[pygame.K_DOWN]:
            ship_y += move_speed
        ship_x = max(50, min(SCREEN_WIDTH - 50, ship_x))
        ship_y = max(50, min(SCREEN_HEIGHT - 50, ship_y))

        if rolling:
            frame += 1
            if frame > 20:
                stat = char.stats["Wits"]
                roll_result = ironsworn_roll(stat)
                rolling = False
                if roll_result[0] == "Strong Hit":
                    char.progress = min(10, char.progress + 3)
                    char.meters["Momentum"] = min(10, char.meters["Momentum"] + 1)
                elif roll_result[0] == "Weak Hit":
                    char.progress = min(10, char.progress + 1)
                    char.meters["Supply"] = max(0, char.meters["Supply"] - 1)
                else:
                    char.meters["Health"] = max(0, char.meters["Health"] - 1)
                    char.meters["Momentum"] = max(-6, char.meters["Momentum"] - 2)

        char.draw_stats(screen)
        char.draw_hud(screen)

        state_text = font.render(f"Situation: {current_state.upper()}", True, (255, 255, 100))
        screen.blit(state_text, (20, 300))

        if roll_result:
            reaction = oracle.get_reaction(current_state)
            react_text = small_font.render(f"Reaction: {reaction}", True, (200, 200, 255))
            screen.blit(react_text, (20, 400))
            pygame.draw.circle(screen, (255, 100, 0), (600, 400), 30)

        draw_dice(screen, rolling, roll_result)

        ship_color = (0, 255, 255) if not roll_result or roll_result[0] != "Miss" else (255, 100, 100)
        pygame.draw.polygon(screen, ship_color, [(ship_x, ship_y), (ship_x + 30, ship_y + 20), (ship_x, ship_y + 40)])

        if current_state == "travel" and (keys[pygame.K_LEFT] or keys[pygame.K_RIGHT] or keys[pygame.K_UP] or keys[pygame.K_DOWN]):
            char.progress = min(10, char.progress + 1)

        instr = small_font.render("Arrows=Move | R=Roll | T=Travel | C=Combat | V=Conv | O=Obstacle", True, (150, 150, 150))
        screen.blit(instr, (20, 550))

    pygame.display.flip()
    clock.tick(60)

pygame.quit()
sys.exit()
