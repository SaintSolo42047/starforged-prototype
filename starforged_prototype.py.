<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Starforged - Solo Sci-Fi TTRPG Prototype</title>
    <style>
        body { margin:0; background:#0a0a1f; font-family:Arial; color:#fff; text-align:center; }
        canvas { border:2px solid #0ff; image-rendering:pixelated; }
    </style>
</head>
<body>
    <h2>Starforged Prototype - Runs in Browser</h2>
    <canvas id="game" width="800" height="600"></canvas>
    <p><b>Controls:</b> Arrow keys = move ship / change stats • R = Roll • T/C/V/O = change situation • ENTER = confirm creation</p>

<script>
// Starforged rules in browser - character creation + full play
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
canvas.width = 800;
canvas.height = 600;

let gameState = "creation"; // "creation" or "playing"
let currentSituation = "travel";

const char = {
    stats: { Edge: 2, Heart: 2, Iron: 2, Shadow: 2, Wits: 2 },
    meters: { Health: 5, Spirit: 5, Supply: 5, Momentum: 2 },
    progress: 0,
    selectedStat: 0
};

const oracles = {
    travel: ["Smooth hyperspace jump", "Pirate intercept", "Derelict signal", "Nebula interference"],
    combat: ["Enemy fighter engages", "Shield overload", "You gain targeting lock", "Hull breach sustained"],
    conversation: ["Station hails peacefully", "Captain demands tribute", "AI reveals coordinates", "Faction turns hostile"],
    obstacle: ["Asteroid field clears", "System glitch arises", "Partial scan success", "Full system failure with cost"]
};

let rollResult = null;
let rolling = false;
let rollFrame = 0;
let shipX = 650;
let shipY = 500;
let keys = {};

function randomChoice(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
}

function ironswornRoll(stat) {
    const action = Math.floor(Math.random() * 6) + 1;
    const c1 = Math.floor(Math.random() * 10) + 1;
    const c2 = Math.floor(Math.random() * 10) + 1;
    const total = action + stat;
    if (total > Math.max(c1, c2)) return {text: "Strong Hit", action, c1, c2};
    if (total > Math.min(c1, c2)) return {text: "Weak Hit", action, c1, c2};
    return {text: "Miss", action, c1, c2};
}

function draw() {
    ctx.fillStyle = "#0a0a1f";
    ctx.fillRect(0, 0, 800, 600);

    // stars
    ctx.fillStyle = "#ccf";
    for (let i = 0; i < 80; i++) {
        ctx.fillRect(Math.random()*800, Math.random()*600, 1, 1);
    }

    if (gameState === "creation") {
        ctx.font = "28px Arial";
        ctx.fillStyle = "#ff0";
        ctx.fillText("CHARACTER CREATION - Starforged", 80, 60);

        const total = Object.values(char.stats).reduce((a,b)=>a+b,0);
        ctx.font = "20px Arial";
        ctx.fillStyle = total === 10 ? "#0f0" : "#f66";
        ctx.fillText(`Total points: ${total} / 10`, 80, 110);

        ctx.font = "24px Arial";
        const statList = Object.keys(char.stats);
        for (let i = 0; i < 5; i++) {
            const name = statList[i];
            const color = (i === char.selectedStat) ? "#ff0" : "#fff";
            ctx.fillStyle = color;
            ctx.fillText(`${name}: ${char.stats[name]}`, 120, 170 + i*50);
        }

        ctx.font = "18px Arial";
        ctx.fillStyle = "#ccc";
        ctx.fillText("← → Select   ↑ ↓ Change   ENTER when total = 10", 50, 520);
    } 
    else {
        // HUD
        ctx.font = "22px Arial";
        let y = 20;
        Object.keys(char.meters).forEach(key => {
            ctx.fillStyle = "#fff";
            ctx.fillText(`${key}: ${char.meters[key]}`, 20, y);
            ctx.fillStyle = "#666";
            ctx.fillRect(200, y-15, 200, 20);
            const fill = key === "Momentum" ? (char.meters[key] + 6) / 16 : char.meters[key] / 5;
            ctx.fillStyle = char.meters[key] > 2 ? "#0f0" : "#f00";
            ctx.fillRect(200, y-15, 200 * Math.max(0, fill), 20);
            y += 45;
        });

        // progress
        ctx.fillStyle = "#fff";
        ctx.fillText("Progress:", 20, y);
        ctx.fillStyle = "#666";
        ctx.fillRect(200, y-15, 200, 20);
        ctx.fillStyle = "#0cf";
        ctx.fillRect(200, y-15, char.progress * 20, 20);

        ctx.fillStyle = "#ff0";
        ctx.fillText(`Situation: ${currentSituation.toUpperCase()}`, 20, 320);

        if (rollResult) {
            ctx.fillStyle = "#ccf";
            ctx.fillText(`Reaction: ${randomChoice(oracles[currentSituation])}`, 20, 400);
        }

        // dice
        ctx.fillStyle = "#ccc";
        ctx.fillRect(300, 280, 60, 60);
        ctx.fillRect(380, 280, 60, 60);
        ctx.fillRect(460, 280, 60, 60);
        if (rolling) {
            ctx.fillStyle = "#ff0";
            ctx.fillText("ROLLING...", 320, 320);
        } else if (rollResult) {
            ctx.fillStyle = "#000";
            ctx.font = "30px Arial";
            ctx.fillText(rollResult.action, 320, 320);
            ctx.fillText(rollResult.c1, 400, 320);
            ctx.fillText(rollResult.c2, 480, 320);
            ctx.font = "28px Arial";
            ctx.fillStyle = rollResult.text === "Strong Hit" ? "#0f0" : rollResult.text === "Weak Hit" ? "#ff0" : "#f00";
            ctx.fillText(rollResult.text, 320, 380);
        } else {
            ctx.fillStyle = "#aaa";
            ctx.fillText("Press R to roll", 310, 320);
        }

        // ship
        const shipColor = (rollResult && rollResult.text === "Miss") ? "#f66" : "#0ff";
        ctx.fillStyle = shipColor;
        ctx.beginPath();
        ctx.moveTo(shipX, shipY);
        ctx.lineTo(shipX + 30, shipY + 20);
        ctx.lineTo(shipX, shipY + 40);
        ctx.fill();

        // instructions
        ctx.font = "16px Arial";
        ctx.fillStyle = "#aaa";
        ctx.fillText("Arrows = Move Ship | R = Roll | T=Travel C=Combat V=Conversation O=Obstacle", 20, 570);
    }

    // always draw stars on top for background effect
}

function gameLoop() {
    draw();

    // creation input
    if (gameState === "creation") {
        if (keys["ArrowLeft"]) { char.selectedStat = (char.selectedStat - 1 + 5) % 5; keys["ArrowLeft"] = false; }
        if (keys["ArrowRight"]) { char.selectedStat = (char.selectedStat + 1) % 5; keys["ArrowRight"] = false; }
        const statName = Object.keys(char.stats)[char.selectedStat];
        if (keys["ArrowUp"]) { char.stats[statName] = Math.min(4, char.stats[statName] + 1); keys["ArrowUp"] = false; }
        if (keys["ArrowDown"]) { char.stats[statName] = Math.max(1, char.stats[statName] - 1); keys["ArrowDown"] = false; }

        const total = Object.values(char.stats).reduce((a,b)=>a+b,0);
        if (keys["Enter"] && total === 10) {
            gameState = "playing";
            keys["Enter"] = false;
        }
    } 
    else {
        // playing movement
        const speed = 5;
        if (keys["ArrowLeft"]) shipX -= speed;
        if (keys["ArrowRight"]) shipX += speed;
        if (keys["ArrowUp"]) shipY -= speed;
        if (keys["ArrowDown"]) shipY += speed;
        shipX = Math.max(50, Math.min(750, shipX));
        shipY = Math.max(50, Math.min(550, shipY));

        if (keys["r"] || keys["R"]) {
            rolling = true;
            rollFrame = 0;
            keys["r"] = keys["R"] = false;
        }

        if (rolling) {
            rollFrame++;
            if (rollFrame > 25) {
                const stat = char.stats.Wits;
                rollResult = ironswornRoll(stat);
                rolling = false;

                if (rollResult.text === "Strong Hit") {
                    char.progress = Math.min(10, char.progress + 3);
                    char.meters.Momentum = Math.min(10, char.meters.Momentum + 1);
                } else if (rollResult.text === "Weak Hit") {
                    char.progress = Math.min(10, char.progress + 1);
                    char.meters.Supply = Math.max(0, char.meters.Supply - 1);
                } else {
                    char.meters.Health = Math.max(0, char.meters.Health - 1);
                    char.meters.Momentum = Math.max(-6, char.meters.Momentum - 2);
                }
            }
        }

        // situation keys
        if (keys["t"] || keys["T"]) currentSituation = "travel";
        if (keys["c"] || keys["C"]) currentSituation = "combat";
        if (keys["v"] || keys["V"]) currentSituation = "conversation";
        if (keys["o"] || keys["O"]) currentSituation = "obstacle";

        // travel progress from movement
        if (currentSituation === "travel" && (keys["ArrowLeft"] || keys["ArrowRight"] || keys["ArrowUp"] || keys["ArrowDown"])) {
            char.progress = Math.min(10, char.progress + 1);
        }
    }

    requestAnimationFrame(gameLoop);
}

// keyboard
window.addEventListener("keydown", e => { keys[e.key] = true; });
window.addEventListener("keyup", e => { keys[e.key] = false; });

gameLoop();
</script>
</body>
</html>
